# --- CONFIGURACIÓN DE AUTENTICACIÓN (Auth.js / NextAuth v5) ---

# Genera una clave secreta segura ejecutando: openssl rand -base64 32
# Y colócala aquí:
AUTH_SECRET=tu_clave_secreta_aqui_generada

# Credenciales de Google OAuth (Obtenidas de Google Cloud Console)
# Configura el redirect URI en Google Console como: http://localhost:4025/api/auth/callback/google
AUTH_GOOGLE_ID=tu_client_id_de_google_aqui.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=tu_client_secret_de_google_aqui
